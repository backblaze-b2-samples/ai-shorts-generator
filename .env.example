# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# B2_REGION drives the S3 endpoint: https://s3.{B2_REGION}.backblazeb2.com
B2_REGION=your_region
# Public base URL for objects (optional — leave blank if your bucket is private)
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001AbCdEfGhIjKlMnOpQrStUvWxYz0=
# B2_BUCKET_NAME=my-shorts-bucket
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-shorts-bucket.s3.us-west-004.backblazeb2.com

# AI moment detection + captioning (core feature) — OpenAI via the Genblaze SDK.
# This is the app's ONE external AI key. Never commit a real key.
OPENAI_API_KEY=your_openai_api_key
SHORTS_MODEL=gpt-4o-mini

# Transcription — local & keyless by default (faster-whisper).
# Set TRANSCRIPTION_BACKEND=openai to use the OpenAI Whisper API instead
# (reuses OPENAI_API_KEY above — still one key total).
TRANSCRIPTION_BACKEND=local
WHISPER_MODEL=base.en

# Clip rendering defaults
CLIPS_PER_VIDEO=3
CLIP_ASPECT=9:16
